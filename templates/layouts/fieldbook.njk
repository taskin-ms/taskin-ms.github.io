---
layout: layouts/base.njk
---
{% set sections = page.rawInput | guideSections %}
<main id="main" class="field-guide wrap">
  <header class="guide-header"><h1>{{ headline }}</h1><p>{{ intro }}</p></header>
  <nav class="guide-contents" aria-label="Guide sections">
    {% for section in sections %}{% if section.number %}<a href="#{{ section.id }}"><span class="mono">{{ section.number }}</span>{{ section_labels[loop.index0] }}</a>{% endif %}{% endfor %}
  </nav>
  <article class="guide-body" aria-label="Compressible turbulence field guide">
    {% for section in sections %}
    <section class="guide-section" id="{{ section.id }}" aria-labelledby="{{ section.id }}-title">
      <h2 id="{{ section.id }}-title">{% if section.number %}<span class="guide-number mono">{{ section.number }}</span>{% endif %}{{ section.title }}</h2>
      {{ section.html | safe }}
      {% if section.number == "02" and collections.publishedNotes.length %}<div class="guide-notes"><h3>Derivations</h3><ul>{% for note in collections.publishedNotes %}<li><a href="{{ note.url }}">{{ note.data.title | replace("\n", " ") }}</a></li>{% endfor %}</ul></div>{% endif %}
      {% if section.sources %}<aside class="guide-sources" aria-labelledby="{{ section.id }}-sources"><h3 id="{{ section.id }}-sources">Sources</h3>{{ section.sources | safe }}</aside>{% endif %}
    </section>
    {% endfor %}
  </article>
</main>
