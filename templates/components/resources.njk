{% set index = 0 %}
{% for area in areas %}
<section class="library-section" id="{{ area.id }}" data-library-section>
  <div class="library-section-heading"><span class="section-number mono">0{{ loop.index }}</span><div><h2>{{ area.title }}</h2><p>{{ area.intro }}</p></div></div>
  {% for resource in collections.resources %}{% if resource.topic == area.id %}{% set index = index + 1 %}
  <article class="resource-row" id="{{ resource.id }}" data-resource data-topic="{{ resource.topic }}" data-format="{{ resource.format }}" data-search="{{ resource | resourceSearch }}">
    <div class="resource-index mono">{% if index < 10 %}0{% endif %}{{ index }}</div>
    <div class="resource-body">
      <div class="resource-meta"><span>{{ resource.label }}</span><span>{{ resource.year }}</span></div>
      <h3><a href="{{ resource.source }}">{{ resource.title }}<span class="outward" aria-hidden="true">{% if resource.format == 'note' %}→{% else %}↗{% endif %}</span></a></h3>
      <p class="resource-authors">{{ resource.authors }}</p><p class="resource-description">{{ resource.summary | inlineMarkdown | safe }}</p>
      <details><summary>Scope &amp; reading cues</summary><div class="resource-detail">{{ resource.notes | markdown | safe }}<p class="source-meta">{{ resource.venue }}<br>{{ resource.access }}</p><a class="text-link" href="{{ resource.source }}">{% if resource.format == 'note' %}Read the derivation{% else %}Visit original source{% endif %} <span aria-hidden="true">{% if resource.format == 'note' %}→{% else %}↗{% endif %}</span></a></div></details>
    </div>
    <div class="resource-format"><span class="format-label">{{ resource.format | formatLabel }}</span></div>
  </article>
  {% endif %}{% endfor %}
</section>
{% endfor %}
