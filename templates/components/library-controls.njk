<form class="library-form" data-library-form role="search" hidden>
  <div class="search-field"><label for="resource-search">Search the fieldbook</label><div class="search-input"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m15 15 5 5" stroke="currentColor" stroke-width="1.8"/></svg><input id="resource-search" name="q" type="search" placeholder="Try Favre, wall cooling, or machine learning" autocomplete="off" aria-controls="resource-library"></div></div>
  <div class="format-field"><label for="resource-format">Format</label><select id="resource-format" name="format" aria-controls="resource-library"><option value="all">All formats</option><option value="book">Books</option><option value="paper">Papers</option><option value="preprint">Preprints</option><option value="dataset">Datasets</option><option value="reference">References</option><option value="note">Study notes</option></select></div>
</form>
<div class="topic-filters" data-topic-controls role="group" aria-label="Filter resources by area" hidden><button type="button" data-topic-filter="all" aria-pressed="true">All areas</button>{% for area in areas %}<button type="button" data-topic-filter="{{ area.id }}" aria-pressed="false">{{ area.filter_label }}</button>{% endfor %}</div>
<div class="results-bar"><p data-results role="status" aria-live="polite" aria-atomic="true">{{ collections.resources | length }} resources available</p><button class="reset-button" type="button" data-reset hidden>Clear filters <span aria-hidden="true">×</span></button></div>
